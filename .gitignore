# macOS
.DS_Store

# Env (never commit secrets)
.env
.env.local
.env.*.local

# Build artifacts
*.tsbuildinfo

# Claude Code local (machine-specific) settings
.claude/settings.local.json

# Node
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Vite
dist
dist-ssr
*.local

# Editor
.idea
.vscode
*.swp

# Misc

# Local MCP server config (project ref, machine-specific) — not shared.
.mcp.json

# Launch video (brag-output/): a generated 12MB render — the mp4, its frames and
# a third-party music track. Re-makeable from the project, and not something a
# git history should carry forever.
brag-output

# Full catalog backup (scripts/catalog-snapshot.mjs): homebrew and shard secrets.
# The public part is derived into supabase/seed.sql, which IS committed.
supabase/catalog_snapshot.sql

# Design canvases (.design/): local working files. The artboards for shipped
# features were removed from the repo and are in git history.
.design

# Rust build directory (the engine crate). The built .wasm IS committed, under packages/engine-wasm/.
target
