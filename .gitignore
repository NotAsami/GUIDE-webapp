# macOS
.DS_Store

# Env (never commit secrets)
.env
.env.local
.env.*.local

# Build artifacts
*.tsbuildinfo

# Claude Code local (machine-specific) settings
.claude/settings.local.json

# Node
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Vite
dist
dist-ssr
*.local

# Editor
.idea
.vscode
*.swp

# Misc

# Local MCP server config (project ref, machine-specific) — not shared.
.mcp.json

# Design canvases (.design/): the .dc.html artboards are the SOURCE and are kept.
# The page they seed into is a ~2.6MB build artifact — re-seedable from the
# artboards any time, and the live canvas lives at its artifact URL.
.design/**/*.html
!.design/**/*.dc.html
